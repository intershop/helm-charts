{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "IntershopPWAHelmValuesSchema",
  "title": "Intershop PWA Helm Values",
  "description": "Values used to deploy the Intershop PWA application and proxy tiers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["config", "app", "proxy", "ingress"],
  "properties": {
    "nameOverride": {
      "type": "string",
      "title": "Chart name override"
    },
    "fullnameOverride": {
      "type": "string",
      "title": "Fully qualified application name override"
    },
    "config": {
      "type": "object",
      "title": "Shared PWA configuration",
      "additionalProperties": false,
      "required": ["icmBaseUrl"],
      "properties": {
        "icmBaseUrl": {
          "type": "string",
          "title": "ICM base URL",
          "description": "Base URL of the Intershop Commerce Management backend.",
          "minLength": 1
        },
        "icmBaseUrlSsr": {
          "type": "string",
          "title": "Internal ICM base URL",
          "description": "Internal ICM base URL used by server-side rendering.",
          "minLength": 1
        },
        "allowedHosts": {
          "type": "string",
          "title": "Allowed hosts",
          "description": "Comma-separated host names accepted by the SSR application.",
          "minLength": 1
        }
      }
    },
    "hybrid": {
      "type": "object",
      "title": "Hybrid approach configuration",
      "description": "Activate the PWA Hybrid Approach. When ICM runs in the same namespace, configure its internal Web Adapter URL.",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enable or disable the hybrid approach",
          "default": false
        },
        "icmInternalURL": {
          "type": "string",
          "title": "Internal ICM Web Adapter URL",
          "description": "Internal Kubernetes URL of the ICM Web Adapter. Required only when ICM runs in the same namespace.",
          "minLength": 1
        },
        "pwaExternalPort": {
          "type": "integer",
          "title": "External PWA port",
          "description": "External PWA port forwarded to Responsive Starter Store requests when it differs from the default port.",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "title": "Image pull secrets",
      "description": "Image pull secrets applied to both tiers' pods.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "title": "Service account configuration",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": {
          "type": "boolean",
          "default": true
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "title": "Pod security context",
      "additionalProperties": true
    },
    "securityContext": {
      "type": "object",
      "title": "Shared container security context",
      "additionalProperties": true
    },
    "app": {
      "$ref": "#/definitions/deploymentConfig"
    },
    "proxy": {
      "allOf": [
        { "$ref": "#/definitions/deploymentConfig" },
        {
          "type": "object",
          "title": "Reverse proxy tier",
          "properties": {
            "multiChannel": {
              "type": "string",
              "title": "Configure top-level URL to app server URL mapping",
              "description": "Multi-channel/-site configuration object"
            },
            "additionalHeaders": {
              "type": "string",
              "title": "Additional response headers configuration",
              "description": "nginx adds specified header for every page response"
            },
            "cacheIgnoreParams": {
              "type": "string",
              "title": "Ignored cache query parameters configuration",
              "description": "nginx ignores query parameters during caching"
            },
            "reset": {
              "type": "object",
              "title": "Proxy cache reset job after upgrade",
              "additionalProperties": false,
              "required": ["enabled"],
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "description": "Enable proxy/nginx reset/restart job after upgrade",
                  "default": true
                },
                "image": {
                  "$ref": "#/definitions/imageReference"
                }
              }
            }
          }
        }
      ]
    },
    "ingress": {
      "type": "object",
      "title": "Ingress configuration",
      "description": "Configure external ingress access to the PWA proxy.",
      "additionalProperties": false,
      "required": ["enabled", "className"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "title": "Enable ingress",
          "default": false
        },
        "className": {
          "type": "string",
          "title": "Ingress class name",
          "default": "nginx",
          "minLength": 1
        },
        "instances": {
          "type": "object",
          "title": "Ingress instances",
          "description": "Configure one or more ingress instances.",
          "additionalProperties": {
            "type": "object",
            "title": "Ingress instance",
            "additionalProperties": false,
            "required": ["hosts"],
            "properties": {
              "tlsSecretName": {
                "type": "string",
                "title": "TLS secret name",
                "minLength": 1
              },
              "annotations": {
                "title": "Ingress annotations",
                "$ref": "#/definitions/stringMap"
              },
              "hosts": {
                "type": "array",
                "title": "Ingress hosts",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "title": "Ingress host",
                  "additionalProperties": false,
                  "required": ["host"],
                  "properties": {
                    "host": {
                      "type": "string",
                      "title": "Host name",
                      "minLength": 1
                    },
                    "tlsSecretName": {
                      "type": "string",
                      "title": "TLS secret name override",
                      "description": "TLS secret name override for this host.",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "title": "Configure monitoring",
      "description": "Optionally deploy Prometheus and Grafana for development and testing.",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "title": "Enable or disable monitoring"
        },
        "prometheus": {
          "type": "object",
          "title": "Prometheus configuration",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string",
              "title": "Prometheus host",
              "description": "Host to expose Prometheus",
              "minLength": 1
            },
            "annotations": {
              "title": "Prometheus ingress annotations",
              "$ref": "#/definitions/stringMap"
            }
          }
        },
        "grafana": {
          "type": "object",
          "title": "Grafana configuration",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string",
              "title": "Grafana host",
              "description": "Host to expose Grafana",
              "minLength": 1
            },
            "annotations": {
              "title": "Grafana ingress annotations",
              "$ref": "#/definitions/stringMap"
            },
            "password": {
              "type": "string",
              "title": "Grafana admin password"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "environmentVariable": {
      "type": "object",
      "title": "Environment variable",
      "description": "Environment variable to set in the container.",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "title": "Name",
          "description": "Name of the environment variable"
        },
        "value": {
          "type": "string",
          "title": "Value",
          "description": "Value of the environment variable"
        },
        "valueFrom": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "imageReference": {
      "type": "object",
      "title": "OCI image reference",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": {
          "type": "string",
          "title": "Image repository",
          "description": "Reference to an image repository/image name.",
          "minLength": 1,
          "examples": ["intershophub/intershop-pwa-ssr"]
        },
        "tag": {
          "type": "string",
          "title": "Image tag",
          "description": "Defaults to release-<chart appVersion> when empty."
        },
        "pullPolicy": {
          "type": "string",
          "title": "Image pull policy",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "deploymentConfig": {
      "type": "object",
      "properties": {
        "image": {
          "$ref": "#/definitions/imageReference"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "required": ["http", "metrics"],
          "properties": {
            "http": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "metrics": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "port"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "env": {
          "type": "array",
          "title": "Extra environment variables",
          "description": "Additional environment variables to set in the container.",
          "default": [],
          "items": {
            "$ref": "#/definitions/environmentVariable"
          }
        },
        "metrics": {
          "type": "object",
          "title": "Prometheus metrics details",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Create Prometheus metrics exporter",
              "default": false
            }
          }
        },
        "securityContext": {
          "type": "object",
          "title": "Container security context",
          "additionalProperties": true
        },
        "resources": {
          "type": "object",
          "additionalProperties": true
        },
        "livenessProbe": {
          "type": "object",
          "additionalProperties": true
        },
        "readinessProbe": {
          "type": "object",
          "additionalProperties": true
        },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "minReplicas",
            "maxReplicas",
            "targetCPUUtilizationPercentage"
          ],
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "affinity": {
          "type": "object",
          "additionalProperties": true
        },
        "podAntiAffinity": {
          "type": "object",
          "title": "Pod anti-affinity configuration",
          "description": "Configure pod anti-affinity rules for distributing pods across nodes",
          "additionalProperties": false,
          "required": ["enabled", "required"],
          "properties": {
            "enabled": {
              "type": "boolean",
              "title": "Enable pod anti-affinity",
              "description": "Enable or disable default anti-affinity rules",
              "default": true
            },
            "required": {
              "type": "boolean",
              "title": "Use hard anti-affinity rule",
              "description": "true: requiredDuringSchedulingIgnoredDuringExecution (hard rule; pod may stay Pending if no suitable node is available), false: preferredDuringSchedulingIgnoredDuringExecution (soft rule; best-effort)",
              "default": false
            }
          }
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "deploymentAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "deploymentLabels": {
          "$ref": "#/definitions/stringMap"
        }
      }
    }
  }
}
